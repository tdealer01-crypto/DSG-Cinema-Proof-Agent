# Isolated Ubuntu Noble CVE-remediation candidate: signed Ubuntu source-build stages.
# NOT THE ACTIVE PRODUCTION IMAGE. Keep Debian Dockerfile.cinema unchanged.
# Git is required for deterministic LOCAL sandbox clone/commit/revision.
# HTTP remote Git is deliberately NOT bundled in Cinema: network/provider
# operations must use separately governed adapters, never implicit Git URLs.
FROM ubuntu:24.04 AS dsg-git-local-builder
WORKDIR /build
RUN set -eux; \
    printf '%s\n' \
      'Types: deb-src' \
      'URIs: http://archive.ubuntu.com/ubuntu/' \
      'Suites: noble noble-updates noble-security' \
      'Components: main universe' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/dsg-source.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential ca-certificates dpkg-dev \
      libssl-dev libexpat1-dev zlib1g-dev libpcre2-dev; \
    apt-get source git; \
    cd /build/git-*/; \
    export DEB_BUILD_MAINT_OPTIONS='hardening=+all'; \
    export CFLAGS="$(dpkg-buildflags --get CFLAGS)"; \
    export CPPFLAGS="$(dpkg-buildflags --get CPPFLAGS)"; \
    export LDFLAGS="$(dpkg-buildflags --get LDFLAGS)"; \
    make -j2 prefix=/opt/dsg-local-git NO_CURL=YesPlease NO_GETTEXT=YesPlease NO_TCLTK=YesPlease all; \
    make prefix=/opt/dsg-local-git NO_CURL=YesPlease NO_GETTEXT=YesPlease NO_TCLTK=YesPlease install; \
    cp COPYING /opt/dsg-local-git/GIT-COPYING; \
    /opt/dsg-local-git/bin/git --version; \
    mkdir -p /tmp/dsg-git-root/DEBIAN /tmp/dsg-git-root/opt /tmp/dsg-git-root/usr/local/bin; \
    cp -a /opt/dsg-local-git /tmp/dsg-git-root/opt/; \
    ln -s /opt/dsg-local-git/bin/git /tmp/dsg-git-root/usr/local/bin/git; \
    printf '%s\n' \
      'Package: git' \
      "Version: $(dpkg-parsechangelog -SVersion)+dsg1" \
      'Source: git' \
      'Architecture: amd64' \
      'Maintainer: DSG build <build@localhost>' \
      'Depends: libc6, libssl3t64, libexpat1, zlib1g, libpcre2-8-0' \
      'Description: Debian-sourced Git for DSG Cinema local-only repository work' \
      > /tmp/dsg-git-root/DEBIAN/control; \
    dpkg-deb --build --root-owner-group /tmp/dsg-git-root /tmp/dsg-git.deb

# The Playwright Chromium binary dynamically requires libcups.so.2.
# Build the Debian-authenticated CUPS library against OpenSSL, NOT GnuTLS.
# Copy only the shared library; no CUPS daemon, printer service or build deps.
FROM ubuntu:24.04 AS dsg-cups-openssl-builder
WORKDIR /build
RUN set -eux; \
    printf '%s\n' \
      'Types: deb-src' \
      'URIs: http://archive.ubuntu.com/ubuntu/' \
      'Suites: noble noble-updates noble-security' \
      'Components: main universe' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/dsg-source.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential ca-certificates dpkg-dev \
      pkg-config libssl-dev zlib1g-dev; \
    apt-get source cups; \
    cd /build/cups-*/; \
    export DEB_BUILD_MAINT_OPTIONS='hardening=+all'; \
    export CFLAGS="$(dpkg-buildflags --get CFLAGS)"; \
    export CPPFLAGS="$(dpkg-buildflags --get CPPFLAGS)"; \
    export LDFLAGS="$(dpkg-buildflags --get LDFLAGS)"; \
    ./configure --with-tls=openssl --disable-static --disable-gssapi; \
    make -C cups -j2 DSOFLAGS="-shared -fPIC $LDFLAGS" LDFLAGS="$LDFLAGS"; \
    mkdir -p /opt/dsg-openssl-cups; \
    cp -L cups/libcups.so.2 /opt/dsg-openssl-cups/libcups.so.2; \
    cp LICENSE /opt/dsg-openssl-cups/CUPS-LICENSE; \
    cp NOTICE /opt/dsg-openssl-cups/CUPS-NOTICE; \
    if ldd /opt/dsg-openssl-cups/libcups.so.2 | grep -q libgnutls; then \
      echo 'BLOCK: source-built libcups retained GnuTLS' >&2; exit 1; \
    fi; \
    readelf -l cups/libcups.so.2 | grep -q GNU_RELRO; \
    readelf -d cups/libcups.so.2 | grep -Eq 'BIND_NOW|FLAGS.*NOW'; \
    mkdir -p /tmp/dsg-cups-root/DEBIAN /tmp/dsg-cups-root/opt \
       /tmp/dsg-cups-root/usr/local/lib; \
    cp -a /opt/dsg-openssl-cups /tmp/dsg-cups-root/opt/; \
    cp -L cups/libcups.so.2 /tmp/dsg-cups-root/usr/local/lib/libcups.so.2; \
    printf '%s\n' \
      'Package: libcups2t64' \
      "Version: $(dpkg-parsechangelog -SVersion)+dsg1" \
      'Source: cups' \
      'Architecture: amd64' \
      'Maintainer: DSG build <build@localhost>' \
      'Depends: libc6, libssl3t64, zlib1g' \
      'Description: Debian-sourced libcups client rebuilt with OpenSSL TLS' \
      > /tmp/dsg-cups-root/DEBIAN/control; \
    dpkg-deb --build --root-owner-group /tmp/dsg-cups-root /tmp/dsg-cups.deb

FROM ubuntu:24.04
LABEL org.opencontainers.image.description="DSG Cinema self-hosted Playwright: Ubuntu-source Git (local only) + CUPS OpenSSL TLS; Git/CUPS/Chromium GnuTLS-unlinked" \
      org.opencontainers.image.licenses="DSG proprietary application; bundled Git GPL and CUPS Apache-2.0 notices in /opt"
WORKDIR /app

# Apt on Noble requires its distro GnuTLS package; removing Essential apt is not
# acceptable. Runtime acceptance is based on verifiable execution-surface
# linkage: local Git (NO_CURL), source-built CUPS (OpenSSL) and Chromium must
# not load GnuTLS. Ubuntu OS packages remain intact and MUST pass the full
# uncompromised zero-CRITICAL/zero-HIGH Trivy and ECR scans.
RUN set -eux; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends ca-certificates python3 python-is-python3 python3-venv \
      libssl3t64 libxml2 libexpat1 zlib1g libpcre2-8-0; \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libc6)" ge '2.39-0ubuntu8.9'; \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libxml2)" ge '2.9.14+dfsg-1.3ubuntu3.10'; \
    rm -rf /var/lib/apt/lists/*
# Register custom native binaries as explicitly named Debian packages so
# Inspector/ECR OS package inventory continues to cover their source versions.
COPY --from=dsg-git-local-builder /tmp/dsg-git.deb /tmp/dsg-git.deb
COPY --from=dsg-cups-openssl-builder /tmp/dsg-cups.deb /tmp/dsg-cups.deb
RUN dpkg -i /tmp/dsg-git.deb /tmp/dsg-cups.deb \
  && rm /tmp/dsg-git.deb /tmp/dsg-cups.deb \
  && ldconfig \
  && dpkg-query -W git libcups2t64
ENV PATH="/opt/dsg-local-git/bin:/opt/dsg-local-git/libexec/git-core:$PATH"

COPY requirements-cinema.noble.txt requirements.txt
# Only the build phase needs pip; avoid vulnerable vendored Python libraries
# in the final service image by removing pip/setuptools/wheel after install.
RUN python -m venv /opt/dsg-cinema \
  && /opt/dsg-cinema/bin/pip install --no-cache-dir --upgrade pip \
  && /opt/dsg-cinema/bin/pip install --no-cache-dir -r requirements.txt \
  && /opt/dsg-cinema/bin/python -m pip uninstall -y pip setuptools wheel
# Ubuntu's python3-venv depends on python3-pip-whl, a build-only bundle
# whose vendored urllib3 has 2 HIGH CVEs (duplicated by ECR source/binary
# inventory). The server needs neither after its venv is built. Purge only
# these NON-ESSENTIAL build tools through apt to preserve package provenance.
# Never purge apt or libgnutls30t64 (Ubuntu Essential apt dependency).
RUN set -eux; \
    apt-get purge -y python3-venv python3-pip-whl python3-setuptools-whl; \
    for pkg in python3-pip-whl python3-setuptools-whl python3-venv; do \
      if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then \
        echo "BLOCK: build-only wheel still installed: $pkg" >&2; exit 1; \
      fi; \
    done; \
    /opt/dsg-cinema/bin/python -c "import fastapi, starlette, cryptography, playwright"; \
    rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/dsg-cinema/bin:$PATH"

# Headless Chromium plus same-page mobile shared viewer and Playwright action
# transport. Printing requires libcups.so.2, built with OpenSSL above.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DSG_BROWSER_PROVIDER=self_hosted \
    DSG_BROWSER_MEMORY_BACKEND=files \
    DSG_MARKET_READY_RUNTIME=/revenue/market-ready \
    DSG_SANDBOX_MODE=0 \
    DSG_PLATFORM_REQUIRE_AUTH=1
RUN set -eux; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends \
       fonts-liberation fonts-noto-color-emoji \
       libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 \
       libatspi2.0-0t64 libcairo2 libdbus-1-3 libdrm2 libgbm1 \
       libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 \
       libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 \
       libxfixes3 libxkbcommon0 libxrandr2; \
    # Preserve distro integrity; do not purge apt or its required GnuTLS. \
    python -m playwright install chromium; \
    ldconfig; \
    git --version; \
    if command -v curl >/dev/null 2>&1; then echo 'BLOCK: curl present' >&2; exit 1; fi; \
    ldd "$(command -v git)" | tee /tmp/dsg-git-ldd.log; \
    ldd /usr/local/lib/libcups.so.2 | tee /tmp/dsg-cups-ldd.log; \
    ldd /ms-playwright/chromium-*/chrome-linux64/chrome | tee /tmp/chrome-ldd.log; \
    for report in /tmp/dsg-git-ldd.log /tmp/dsg-cups-ldd.log /tmp/chrome-ldd.log; do \
      if grep -q 'not found' "$report"; then echo "BLOCK: unresolved runtime linkage: $report" >&2; exit 1; fi; \
      if grep -q 'libgnutls' "$report"; then echo "BLOCK: GnuTLS linked into governed execution surface: $report" >&2; exit 1; fi; \
    done; \
    rm -rf /var/lib/apt/lists/* /tmp/chrome-ldd.log /tmp/dsg-git-ldd.log /tmp/dsg-cups-ldd.log

COPY cinema_main.py marketplace_verification.py ./
COPY logging_config.py middleware.py metrics.py error_monitoring.py sentry_config.py ./
COPY revenue ./revenue
COPY api_v1 ./api_v1
COPY web ./web
COPY openapi ./openapi
COPY stripe-app ./stripe-app
COPY market_ready_payload ./market_ready_payload
COPY tools ./tools
# OWNER service configuration is deliberately hash-only. Copy only this exact
# non-secret file rather than the whole config directory into the runtime image.
COPY config/owner-service-accounts.json ./config/owner-service-accounts.json

# Reconstruct the exact sandbox-tested HTML/CSS/JS from deterministic payload
# chunks. The build fails on any byte drift. config.js is the documented
# same-origin production adaptation (apiBase="") rather than the sandbox /dsg proxy.
RUN python market_ready_payload/reconstruct.py

ENV PORT=8000
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=2)" || exit 1

CMD ["uvicorn", "cinema_main:app", "--host", "0.0.0.0", "--port", "8000"]
