FROM python:3.11-slim

WORKDIR /app

# Market-ready installation provisioning creates deterministic local Git source
# snapshots and isolated target clones. Git is runtime infrastructure here, not
# a customer credential or remote repository grant.
RUN printf '%s\n' \
      'Types: deb' \
      'URIs: http://deb.debian.org/debian' \
      'Suites: trixie-backports' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/trixie-backports.sources \
  && apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && apt-get install -y --no-install-recommends -t trixie-backports libcurl3t64-gnutls \
  && LIBCURL_VERSION="$(dpkg-query -W -f='${Version}' libcurl4-gnutls)" \
  && dpkg --compare-versions "$LIBCURL_VERSION" ge "8.21.0-2~bpo13+1" \
  && echo "CINEMA_LIBCURL_VERSION=$LIBCURL_VERSION" \
  && rm -rf /var/lib/apt/lists/*

COPY requirements-cinema.txt requirements.txt
RUN python -m venv /opt/dsg-cinema \
  && /opt/dsg-cinema/bin/pip install --no-cache-dir --upgrade pip \
  && /opt/dsg-cinema/bin/pip install --no-cache-dir -r requirements.txt
ENV PATH="/opt/dsg-cinema/bin:$PATH"

# Self-hosted Chromium runtime. Install only Chromium and its required system
# dependencies instead of inheriting the broad Playwright Noble multimedia stack.
# curl is only needed by the installer/download path; remove the CLI package from
# the final runtime because the previous ECR scan bound all CRITICAL findings to it.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DSG_BROWSER_PROVIDER=azure_local \
    DSG_BROWSER_MEMORY_BACKEND=azure_files \
    DSG_MARKET_READY_RUNTIME=/revenue/market-ready \
    DSG_SANDBOX_MODE=0 \
    DSG_PLATFORM_REQUIRE_AUTH=1
# Playwright 1.62.0 Debian 13 Chromium dependencies copied from
# microsoft/playwright v1.62.0 nativeDeps.ts. Avoid `--with-deps`: that path
# currently pulls Debian curl 8.14.1-2+deb13u5, which AWS ECR reports with
# CRITICAL CVE-2026-8924 and CVE-2026-8927.
RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends \
       fonts-liberation \
       fonts-noto-color-emoji \
       libasound2t64 \
       libatk-bridge2.0-0t64 \
       libatk1.0-0t64 \
       libatspi2.0-0t64 \
       libcairo2 \
       libcups2t64 \
       libdbus-1-3 \
       libdrm2 \
       libgbm1 \
       libglib2.0-0t64 \
       libnspr4 \
       libnss3 \
       libpango-1.0-0 \
       libx11-6 \
       libxcb1 \
       libxcomposite1 \
       libxdamage1 \
       libxext6 \
       libxfixes3 \
       libxkbcommon0 \
       libxrandr2 \
  && python -m playwright install chromium \
  && rm -rf /var/lib/apt/lists/* \
  && ! command -v curl

COPY cinema_main.py marketplace_verification.py ./
COPY logging_config.py middleware.py metrics.py error_monitoring.py sentry_config.py ./
COPY revenue ./revenue
COPY api_v1 ./api_v1
COPY web ./web
COPY openapi ./openapi
COPY stripe-app ./stripe-app
COPY market_ready_payload ./market_ready_payload
COPY tools ./tools
# OWNER service configuration is deliberately hash-only. Copy only this exact
# non-secret file rather than the whole config directory into the runtime image.
COPY config/owner-service-accounts.json ./config/owner-service-accounts.json

# Reconstruct the exact sandbox-tested HTML/CSS/JS from deterministic payload
# chunks. The build fails on any byte drift. config.js is the documented
# same-origin production adaptation (apiBase="") rather than the sandbox /dsg proxy.
RUN python market_ready_payload/reconstruct.py

ENV PORT=8000
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=2)" || exit 1

CMD ["uvicorn", "cinema_main:app", "--host", "0.0.0.0", "--port", "8000"]
